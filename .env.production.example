# Production settings for Myperfum. Copy to `.env` on the server and replace every
# value in <angle brackets>; `php artisan app:launch-check` then says what is missing.

APP_NAME="Myperfum"
APP_ENV=production
# Generate once with `php artisan key:generate` and keep it: it encrypts sessions.
APP_KEY=
APP_DEBUG=false
# The public address, in https. Links in e-mails and the sitemap are built from it.
APP_URL=https://<www.your-domain.ma>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Casablanca

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<database>
DB_USERNAME=<user>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over https.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# The domains the storefront and the admin are served from (no scheme), comma-separated.
SANCTUM_STATEFUL_DOMAINS=<your-domain.ma>,<www.your-domain.ma>

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# E-mails are sent by a queue worker: `php artisan queue:work --tries=3` kept running.
QUEUE_CONNECTION=database

CACHE_STORE=database

# A sending service over SMTP (Brevo, Mailgun, Postmark, Amazon SES…), with the
# domain verified there (SPF and DKIM records) so messages do not land in spam.
MAIL_MAILER=smtp
# `smtps` for port 465; null for 587 (STARTTLS).
MAIL_SCHEME=null
MAIL_HOST=<smtp-relay.brevo.com>
MAIL_PORT=587
MAIL_USERNAME=<smtp login>
MAIL_PASSWORD=<smtp key>
MAIL_FROM_ADDRESS="<commandes@your-domain.ma>"
MAIL_FROM_NAME="${APP_NAME}"

# Only public, non-secret values may use the VITE_ prefix (they are shipped to browsers).
VITE_APP_NAME="${APP_NAME}"
